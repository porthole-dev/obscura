<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Giuseppe Maggio -->
<component type="desktop-application">
  <id>io.github.porthole_dev.Obscura</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Obscura</name>
  <summary>Take photos and videos with every control your camera has</summary>
  <description>
    <p>
      Obscura is a camera app for phones and computers that talks to libcamera
      directly, so it can offer whatever the camera itself can do.
    </p>
    <ul>
      <li>Controls generated from what the camera reports: exposure time, sensitivity, exposure compensation, white balance, focus, frame rate and more</li>
      <li>Every sensor mode the camera offers, from full resolution to high frame rate binned modes</li>
      <li>RAW photos as DNG alongside JPEG</li>
      <li>Live readout of exposure, sensitivity, colour temperature and focus</li>
    </ul>
  </description>
  <developer id="io.github.porthole_dev">
    <name>Giuseppe Maggio</name>
  </developer>
  <launchable type="desktop-id">io.github.porthole_dev.Obscura.desktop</launchable>
  <url type="homepage">https://github.com/porthole-dev/obscura</url>
  <url type="bugtracker">https://github.com/porthole-dev/obscura/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>The viewfinder, with exposure and focus at a glance</caption>
      <image>https://raw.githubusercontent.com/porthole-dev/obscura/main/data/screenshots/photo.png</image>
    </screenshot>
    <screenshot>
      <caption>Every control the camera has</caption>
      <image>https://raw.githubusercontent.com/porthole-dev/obscura/main/data/screenshots/controls.png</image>
    </screenshot>
    <screenshot>
      <caption>Video, with resolution and frame rate</caption>
      <image>https://raw.githubusercontent.com/porthole-dev/obscura/main/data/screenshots/video.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <translation type="gettext">obscura</translation>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.2.0" date="2026-09-15">
      <description>
        <p>A redesigned camera for phones and desktops.</p>
        <ul>
          <li>Pictures come out upright, including landscape shots on phones</li>
          <li>Current exposure, white balance and focus over the viewfinder, one tap from their controls</li>
          <li>Tap to focus, digital zoom, grid, self-timer, and shutter feedback</li>
          <li>Controls in a sidebar or a bottom sheet, following the window size</li>
          <li>Faster start and a viewfinder that never falls behind</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-09-14"/>
  </releases>
</component>
